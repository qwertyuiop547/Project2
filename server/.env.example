# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/barangay_portal?schema=public"

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# ============================================
# FREE AI OPTIONS (no credit card needed)
# ============================================
# Option 1 — Ollama (BEST, 100% free, runs on your PC, no API key)
#   Install: winget install Ollama.Ollama
#   Then run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Option 2 — Google Gemini (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option 3 — Groq (free at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 4 — OpenRouter (free & paid models at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Option 5 — OpenAI (paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
